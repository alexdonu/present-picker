{
  "name": "present-picker",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "dev:lan": "nuxt dev --public --qr",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "db:clean": "tsx --env-file-if-exists=.env scripts/clean.ts",
    "db:status": "tsx --env-file-if-exists=.env scripts/status.ts"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "nuxt": "^4.5.2",
    "tailwindcss": "^4.3.3",
    "vue": "^3.5.43",
    "vue-router": "^5.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vue-tsc": "^3.3.11"
  }
}
