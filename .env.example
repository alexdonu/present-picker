# Copy this file to `.env` and fill in the values. `.env` is git-ignored.

# Password shared by the admins for /admin.
NUXT_ADMIN_PASSWORD=change-me

# Secret used to sign the admin session cookie. Must be at least 32 characters.
# Generate one with: openssl rand -hex 32
NUXT_SESSION_SECRET=

# Access to the MIC2 webhook playground (/admin/mic2) only, for someone who must not see the party admin.
# Leave empty to let only the party admins in.
# NUXT_MIC2_LOGIN=someone@example.com
# NUXT_MIC2_PASSWORD=

# Where the SQLite database and the uploaded images are stored.
# Must be a persistent directory on the server. Defaults to ./data
# NUXT_DATA_DIR=./data

# On the real server, also set this. Besides the usual production behaviour, it makes `npm run db:seed`
# refuse to fill the real database with sample data.
# NODE_ENV=production
